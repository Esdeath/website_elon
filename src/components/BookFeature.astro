---
import { BOOK } from "../lib/book";
const [shortTitle, subject] = BOOK.title.split("：");
---

<section class="book-feature shell" aria-labelledby="book-title">
  <div class="book-cover" aria-hidden="true">
    <span>第一性<br />原理</span>
    <small>马斯克<br />创业与管理问答录</small>
  </div>
  <div class="book-copy">
    <p class="book-format">在线阅读</p>
    <h2 id="book-title"><a href={BOOK.path}><span>{shortTitle}：</span><span>{subject}</span></a></h2>
    <p class="book-summary">{BOOK.subtitle}</p>
    <p class="book-details">{BOOK.chapterCount} 章 / {BOOK.questionCount} 组问答 / {BOOK.sourceCount} 个来源</p>
  </div>
  <div class="book-actions">
    <a class="button" href={BOOK.path}>阅读全文</a>
    <a class="quiet-link" href={`${BOOK.path}#chapter-01`}>从第一章开始</a>
  </div>
</section>

<style>
  .book-feature {
    display: grid;
    grid-template-columns: 118px minmax(0, 1fr) auto;
    gap: 32px;
    align-items: center;
    margin-top: 40px;
    padding: 28px;
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .book-cover {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 156px;
    padding: 20px 12px 16px 16px;
    border-left: 5px solid #27483e;
    color: white;
    background: var(--signal);
    font-family: var(--serif);
  }

  .book-cover span { font-size: 1.16rem; font-weight: 700; }
  .book-cover small { font-size: 0.63rem; line-height: 1.8; }
  .book-format { margin: 0 0 9px; color: var(--signal); font-size: 0.8rem; }
  .book-copy h2 { margin: 0; font-family: var(--serif); font-size: clamp(1.25rem, 2vw, 1.65rem); line-height: 1.5; }
  .book-copy h2 a { text-decoration: none; }
  .book-copy h2 a:hover { text-decoration: underline; }
  .book-summary { margin: 10px 0 0; color: var(--muted); font-size: 0.9rem; line-height: 1.8; }
  .book-details { margin: 12px 0 0; color: var(--muted); font-size: 0.8rem; }
  .book-actions { display: flex; flex-direction: column; gap: 14px; align-items: center; font-size: 0.82rem; white-space: nowrap; }
  .book-actions .button { min-width: 132px; }

  @media (max-width: 960px) {
    .book-feature { grid-template-columns: 100px minmax(0, 1fr); gap: 20px 24px; }
    .book-cover { grid-row: 1 / 3; align-self: stretch; }
    .book-cover span { font-size: 1rem; }
    .book-actions { flex-direction: row; grid-column: 2; }
  }

  @media (max-width: 540px) {
    .book-feature { grid-template-columns: minmax(0, 1fr); padding: 22px; margin-top: 28px; }
    .book-cover { display: none; }
    .book-actions { grid-column: 1; flex-wrap: wrap; }
    .book-copy h2 span { display: block; }
  }
</style>
