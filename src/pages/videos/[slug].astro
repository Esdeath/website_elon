---
import { getCollection } from "astro:content";
import { ArrowLeft, ExternalLink, FileText, ShieldCheck } from "@lucide/astro";
import LanguageSwitch from "../../components/LanguageSwitch.astro";
import LazyVideo from "../../components/LazyVideo.astro";
import Transcript from "../../components/Transcript.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  CONTENT_LABELS,
  TRANSLATION_LABELS,
  TYPE_LABELS,
  formatDate,
  formatDuration,
  privacyEmbedUrl,
  videoThumbnail,
  videoYear,
} from "../../lib/display";
import { buildDetailJsonLd, buildDetailMetaTitles, isHttpUrl } from "../../lib/seo";
import type { VideoEntry } from "../../lib/types";

export async function getStaticPaths() {
  const entries = await getCollection("videos");
  const metaTitles = buildDetailMetaTitles(entries.map((entry) => entry.data));
  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: {
      video: entry.data,
      metaTitle: metaTitles.get(entry.data.slug),
      related: entries.map((item) => item.data)
        .filter((video) => video.slug !== entry.data.slug && video.type === entry.data.type)
        .sort((a, b) => Number(b.org === entry.data.org) - Number(a.org === entry.data.org)
          || b.date.localeCompare(a.date) || a.slug.localeCompare(b.slug))
        .slice(0, 4),
    },
  }));
}

interface Props {
  video: VideoEntry;
  metaTitle: string;
  related: VideoEntry[];
}

const { video, metaTitle, related } = Astro.props;
const title = video.titleZh || video.titleEn;
const description = video.summaryZh || video.summaryEn || `${title}的中文实录与英文原文。`;
const thumbnail = videoThumbnail(video);
const embedUrl = privacyEmbedUrl(video.embedUrl);
const statusLabel = TRANSLATION_LABELS[video.translation.status];
const canonical = new URL(`/videos/${video.slug}/`, Astro.site || Astro.url.origin).toString();
const modified = video.translation.reviewedAt || video.translation.translatedAt || video.fetchedAt;
const transcriptSource = isHttpUrl(video.transcriptSource)
  && ![video.sourceUrl, video.archiveUrl].includes(video.transcriptSource)
  ? video.transcriptSource
  : undefined;
const hasStructuredVideo = Boolean(embedUrl && thumbnail);
const jsonLd = buildDetailJsonLd(video, { canonical, description, thumbnail, embedUrl });
---

<BaseLayout
  title={metaTitle}
  description={description}
  image={thumbnail}
  imageAlt={`${title} 视频缩略图`}
  canonical={canonical}
  ogType={hasStructuredVideo ? "video.other" : "article"}
  videoEmbedUrl={embedUrl}
  videoDuration={video.durationSec}
  datePublished={video.date}
  dateModified={modified}
  markdownAlternate={`/videos/${video.slug}.md`}
  jsonLd={jsonLd}
>
  <article
    class="detail-page"
    id="detail-top"
    data-pagefind-body
    data-pagefind-filter={`type:${TYPE_LABELS[video.type]}`}
  >
    <header class="detail-head">
      <div class="shell">
        <a class="back-link" href="/">
          <ArrowLeft size={17} stroke-width={1.8} aria-hidden="true" />
          返回影像目录
        </a>
        <p class="meta-line">
          <time datetime={video.date} data-pagefind-meta="date[datetime]">{formatDate(video.date)}</time>
          <a href={`/categories/${video.type}/`}>{TYPE_LABELS[video.type]}</a>
          {video.org && <span data-pagefind-filter="org">{video.org}</span>}
          {video.durationSec !== undefined && <span>{formatDuration(video.durationSec)}</span>}
        </p>
        <div data-lang-block="zh">
          <h1
            data-pagefind-meta="title"
            data-pagefind-filter={`year:${videoYear(video.date)}`}
            lang={video.titleZh ? undefined : "en"}
          >{title}</h1>
        </div>
        <div data-lang-block="en" data-pagefind-ignore hidden lang="en">
          <h1>{video.titleEn}</h1>
        </div>
      </div>
    </header>

    <div class="detail-layout shell">
      <aside class="media-column" aria-label="视频与来源">
        <LazyVideo embedUrl={video.embedUrl} thumbnailUrl={thumbnail} sourceUrl={video.sourceUrl} title={title} />
        <div class="source-actions" style={`--source-count: ${transcriptSource ? 3 : 2}`}>
          <a href={video.sourceUrl} target="_blank" rel="cite external noreferrer">
            <ExternalLink size={16} stroke-width={1.8} aria-hidden="true" />
            原始来源
          </a>
          <a href={video.archiveUrl} target="_blank" rel="cite external noreferrer">
            <FileText size={16} stroke-width={1.8} aria-hidden="true" />
            英文档案页
          </a>
          {transcriptSource && (
            <a href={transcriptSource} target="_blank" rel="cite external noreferrer">
              <FileText size={16} stroke-width={1.8} aria-hidden="true" />
              文字记录来源
            </a>
          )}
        </div>
        <dl class="record-note">
          <div><dt>资料编号</dt><dd>{video.id}</dd></div>
          {video.sourceLabel && <div><dt>来源标注</dt><dd>{video.sourceLabel}</dd></div>}
          <div><dt>正文类型</dt><dd>{CONTENT_LABELS[video.contentKind]}</dd></div>
          <div><dt>翻译状态</dt><dd><span class="status" data-status={video.translation.status}>{statusLabel}</span></dd></div>
        </dl>
      </aside>

      <div class="reading-column">
        <div class="reading-tools">
          <LanguageSwitch />
          <p><ShieldCheck size={16} stroke-width={1.8} aria-hidden="true" /> 机器翻译，已尽力保留原意与数字</p>
        </div>

        {(video.summaryZh || video.summaryEn) && (
          <section class="abstract" aria-labelledby="abstract-title">
            <h2 id="abstract-title">内容摘要</h2>
            <p data-lang-block="zh" lang={video.summaryZh ? undefined : "en"}>{video.summaryZh || video.summaryEn}</p>
            <p data-lang-block="en" data-pagefind-ignore hidden lang="en">{video.summaryEn}</p>
          </section>
        )}

        <section class="citation-note" aria-labelledby="citation-title" data-pagefind-ignore>
          <h2 id="citation-title">引用这份档案</h2>
          <p>{title}（{video.date}），马斯克中文档案。</p>
          <p>资料更新：<time datetime={modified}>{formatDate(modified.slice(0, 10))}</time>。中文为机器翻译，引用具体观点时请核对英文原文与原始来源。</p>
          <p><a href={canonical}>永久链接</a> · <a href={`/videos/${video.slug}.md`}>Markdown 全文</a> · <a href="/rights/">纠错与来源说明</a></p>
        </section>

        <Transcript {video} canSeek={Boolean(embedUrl)} />

        {related.length > 0 && (
          <nav class="related-records" aria-labelledby="related-title" data-pagefind-ignore>
            <h2 id="related-title">更多{TYPE_LABELS[video.type]}资料</h2>
            <ul>{related.map((item) => (
              <li><a href={`/videos/${item.slug}/`}>{item.titleZh || item.titleEn}</a> <time datetime={item.date}>{item.date}</time></li>
            ))}</ul>
            <a href={`/categories/${video.type}/`}>浏览全部{TYPE_LABELS[video.type]}档案</a>
          </nav>
        )}
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .citation-note, .related-records { margin-top: 32px; padding-block: 20px; border-top: 1px solid var(--line); font-size: 0.85rem; overflow-wrap: anywhere; }
  .citation-note h2, .related-records h2 { font-family: var(--serif); font-size: 1.2rem; }
  .citation-note p, .related-records time { color: var(--muted); }
  .related-records li { margin-block: 12px; }

  .detail-page {
    --media-width: minmax(380px, 0.92fr);
  }

  .detail-head {
    border-bottom: 1px solid var(--line-dark);
    background: var(--surface);
  }

  .detail-head .shell {
    padding-block: 33px 44px;
  }

  .back-link {
    display: inline-flex;
    gap: 7px;
    align-items: center;
    margin-bottom: 42px;
    color: var(--muted);
    font-size: 0.82rem;
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--launch);
  }

  .detail-head h1 {
    max-width: 1000px;
    margin: 18px 0 0;
    font-family: var(--serif);
    font-size: 4.35rem;
    font-weight: 680;
    line-height: 1.18;
    overflow-wrap: anywhere;
  }

  .detail-layout {
    display: grid;
    grid-template-columns: var(--media-width) minmax(0, 1.38fr);
    gap: clamp(38px, 6vw, 84px);
    align-items: start;
    padding-top: 48px;
  }

  .media-column {
    position: sticky;
    top: 24px;
  }

  .source-actions {
    display: grid;
    grid-template-columns: repeat(var(--source-count, 2), minmax(0, 1fr));
    border: 1px solid var(--line-dark);
    border-top: 0;
    background: var(--surface);
  }

  .source-actions a {
    display: flex;
    gap: 7px;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    border-inline-end: 1px solid var(--line);
    font-size: 0.8rem;
    text-align: center;
    text-decoration: none;
  }

  .source-actions a:last-child {
    border-inline-end: 0;
  }

  .source-actions a:hover {
    color: var(--launch);
  }

  .record-note {
    margin: 24px 0 0;
    border-top: 1px solid var(--line-dark);
    font-size: 0.76rem;
  }

  .record-note div {
    display: grid;
    grid-template-columns: 86px minmax(0, 1fr);
    gap: 12px;
    padding-block: 10px;
    border-bottom: 1px solid var(--line);
  }

  .record-note dt {
    color: var(--muted);
  }

  .record-note dd {
    min-width: 0;
    margin: 0;
    overflow-wrap: anywhere;
  }

  .reading-tools {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    align-items: center;
    min-height: 52px;
    padding-bottom: 13px;
    border-bottom: 1px solid var(--line-dark);
  }

  .reading-tools p {
    display: inline-flex;
    gap: 7px;
    align-items: center;
    margin: 0;
    color: var(--muted);
    font-size: 0.74rem;
  }

  .abstract {
    padding: 34px 0 38px;
    border-bottom: 1px solid var(--line-dark);
  }

  .abstract h2 {
    margin: 0 0 13px;
    font-size: 0.82rem;
    font-weight: 650;
  }

  .abstract p {
    margin: 0;
    font-family: var(--serif);
    font-size: 1.1rem;
    line-height: 1.9;
  }

  @media (max-width: 980px) {
    .detail-layout {
      grid-template-columns: 1fr;
    }

    .media-column {
      position: static;
    }
  }

  @media (max-width: 760px) {
    .detail-head h1 {
      font-size: 2.85rem;
    }
  }

  @media (max-width: 600px) {
    .detail-head .shell {
      padding-block: 25px 32px;
    }

    .back-link {
      margin-bottom: 30px;
    }

    .detail-head h1 {
      font-size: 2.15rem;
    }

    .detail-layout {
      gap: 34px;
      padding-top: 28px;
    }

    .source-actions {
      grid-template-columns: 1fr;
    }

    .source-actions a {
      border-inline-end: 0;
      border-bottom: 1px solid var(--line);
    }

    .source-actions a:last-child {
      border-bottom: 0;
    }

    .reading-tools {
      align-items: flex-start;
      flex-direction: column;
      padding-bottom: 17px;
    }
  }
</style>
