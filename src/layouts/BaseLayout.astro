---
import "@fontsource-variable/ibm-plex-sans";
import "../styles/global.css";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { serializeJsonLd } from "../lib/json-ld";
import { SITE_DESCRIPTION, SITE_NAME, truncateDescription } from "../lib/seo";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  canonical?: string;
  ogType?: "website" | "article" | "video.other";
  videoEmbedUrl?: string;
  videoDuration?: number;
  datePublished?: string;
  dateModified?: string;
  markdownAlternate?: string;
  noindex?: boolean;
  excludeFromSearch?: boolean;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title = SITE_NAME,
  description = SITE_DESCRIPTION,
  image,
  imageAlt = title,
  canonical = new URL(Astro.url.pathname, Astro.site || Astro.url.origin).toString(),
  ogType = "website",
  videoEmbedUrl,
  videoDuration,
  datePublished,
  dateModified,
  markdownAlternate,
  noindex = false,
  excludeFromSearch = false,
  jsonLd,
} = Astro.props;

const origin = Astro.site || Astro.url.origin;
const canonicalUrl = new URL(canonical, origin).toString();
const imageUrl = image ? new URL(image, origin).toString() : undefined;
const markdownUrl = markdownAlternate ? new URL(markdownAlternate, origin).toString() : undefined;
const ogVideoUrl = videoEmbedUrl ? new URL(videoEmbedUrl, origin).toString() : undefined;
const pageTitle = title === SITE_NAME ? title : `${title}｜${SITE_NAME}`;
const metaDescription = truncateDescription(description);
const robots = noindex
  ? "noindex,follow"
  : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f4f6f5" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://i.ytimg.com" crossorigin />
    <link rel="describedby" href="/llms.txt" type="text/plain" />
    <link rel="index" href="/archive.json" type="application/json" title="马斯克中文档案索引" />
    {markdownUrl && <link rel="alternate" href={markdownUrl} type="text/markdown" title={`${title} Markdown`} />}
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="robots" content={robots} />
    <meta name="application-name" content={SITE_NAME} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl?.startsWith("https://") && <meta property="og:image:secure_url" content={imageUrl} />}
    {imageUrl && <meta property="og:image:alt" content={imageAlt} />}
    {ogType === "video.other" && ogVideoUrl && <meta property="og:video" content={ogVideoUrl} />}
    {ogType === "video.other" && ogVideoUrl?.startsWith("https://") && <meta property="og:video:secure_url" content={ogVideoUrl} />}
    {ogType === "video.other" && ogVideoUrl && <meta property="og:video:type" content="text/html" />}
    {ogType === "video.other" && videoDuration && <meta property="video:duration" content={String(Math.round(videoDuration))} />}
    {ogType === "article" && datePublished && <meta property="article:published_time" content={datePublished} />}
    {ogType === "article" && dateModified && <meta property="article:modified_time" content={dateModified} />}
    <meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {imageUrl && <meta name="twitter:image:alt" content={imageAlt} />}

    {jsonLd && (
      <script is:inline type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <SiteHeader />
    <main id="main-content" data-pagefind-ignore={excludeFromSearch ? true : undefined}>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
